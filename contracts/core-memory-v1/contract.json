{
  "schema_version": 3,
  "page_version": {
    "normalization": "crlf-and-cr-to-lf",
    "encoding": "utf-8",
    "algorithm": "sha256",
    "prefix": "",
    "hex_chars": 8
  },
  "limits": {
    "max_dynamic_pages": {
      "topics": 50,
      "areas": 50,
      "people": 100
    },
    "max_description_chars": 80,
    "max_aliases_per_page": 6,
    "max_fixed_page_chars": 2000,
    "max_dynamic_page_chars": 5000,
    "max_read_paths": 15,
    "max_mutation_operations": 15,
    "max_facts_per_operation": 30
  },
  "fact_normalization": {
    "line_pattern": "^- \\[(stated|observed)\\] (.+?)(?: \\[(\\d{4}-\\d{2}-\\d{2})\\])?$",
    "blank_lines": "ignored",
    "content_trim": "unicode-strip",
    "max_write_content_chars": 800,
    "max_selector_content_chars": 4096,
    "max_read_content_chars": 4096,
    "length_checked": "after-trim",
    "duplicate_key": ["basis", "trimmed-content"],
    "date_suffix": " [YYYY-MM-DD]",
    "legacy_date": null
  },
  "fixtures": {
    "canonical/profile.md": "76f26f56",
    "canonical/preferences.md": "475eb15b",
    "legacy-sources/profile.md": "7550a6e7",
    "legacy-sources/preferences.md": "6f9a35ec"
  }
}
